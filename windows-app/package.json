{
  "name": "attendmark-desktop",
  "version": "1.0.0",
  "description": "AttendMark Native Offline Windows Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "author": "AttendMark",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.attendmark.desktop",
    "productName": "AttendMark",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AttendMark"
    },
    "directories": {
      "output": "dist"
    }
  }
}
